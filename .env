# Database Configuration
# Set DB_TYPE to 'sqlite' or 'postgresql'
DB_TYPE=sqlite

# PostgreSQL Configuration (only needed if DB_TYPE=postgresql)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=pharmasoft
# PG_USER=postgres
# PG_PASSWORD=your_password_here

# Enable SSL for PostgreSQL (set to 'true' for production)
# PG_SSL=false

# Application Environment
NODE_ENV=development
